# =============================================================================
# Bansari Commerce — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
#
# For Vercel deployment, add every variable in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# See ENVIRONMENT.md for full setup instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API

# Public anon key — safe to expose to the browser.
# Used by the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key — NEVER expose to the browser or commit to git.
# Used exclusively by server-side API routes to bypass RLS for trusted writes.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
# Found in: Razorpay Dashboard → Settings → API Keys

# Public key ID — safe to expose to the browser (used to load Razorpay.js).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Secret key — NEVER expose to the browser.
# Used server-side to:
#   1. Create Razorpay orders (/api/orders/create-order)
#   2. Verify payment HMAC signatures (/api/orders/create)
#   3. Fetch payment details for webhook recovery (/api/webhook)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Webhook secret — set in Razorpay Dashboard → Webhooks → your endpoint → Secret.
# Used to verify Razorpay webhook deliveries via HMAC-SHA256 over the raw body.
# Different from RAZORPAY_KEY_SECRET — this is a dedicated webhook signing secret.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# Resend (transactional email)
# -----------------------------------------------------------------------------
# Found in: Resend Dashboard → API Keys
# Requires a verified sending domain configured in Resend.

RESEND_API_KEY=re_xxxxxxxxxxxx

# The verified From address used for all outbound emails.
# Must match a domain verified in your Resend account.
RESEND_FROM_EMAIL=orders@bansaricollections.com

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public canonical URL of the site — no trailing slash.
# Used by robots.ts, sitemap.ts, og-image metadata, and email templates.

NEXT_PUBLIC_SITE_URL=https://www.bansaricollection.in

# -----------------------------------------------------------------------------
# Meta (Facebook) — Pixel + Conversions API
# -----------------------------------------------------------------------------
# Pixel ID. Found in: Meta Events Manager → Data Sources → your pixel.
# Public by design: it ships in the page HTML and is visible to anyone
# inspecting network traffic, so NEXT_PUBLIC_ is correct.
#
# IMPORTANT (Vercel): do NOT tick "Sensitive" on any NEXT_PUBLIC_ variable.
# Vercel withholds Sensitive values at build time, so the inlined value
# silently becomes `undefined` and the pixel never loads.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# Conversions API access token — SERVER ONLY. NEVER add a NEXT_PUBLIC_ prefix.
# Found in: Events Manager → your pixel → Settings → Conversions API →
#           Generate access token.
# Grants the ability to write conversion events to the pixel above. Used by
# src/lib/meta-capi.ts to report Purchase server-side, which recovers the
# conversions the browser pixel loses to ad blockers, iOS ATT, closed tabs and
# redirect-based Cashfree returns.
#
# Leave unset and the whole server-side path no-ops cleanly — the browser pixel
# is unaffected.
META_CAPI_ACCESS_TOKEN=

# Test event code — set ONLY while validating in Events Manager → Test Events,
# then remove. Events sent with this code are diverted to the test stream and
# do NOT count as real conversions.
META_CAPI_TEST_EVENT_CODE=

# -----------------------------------------------------------------------------
# Google — GA4 + Google Ads (gtag.js)
# -----------------------------------------------------------------------------
# Loaded directly via gtag.js, NOT Google Tag Manager: GTM would require a much
# looser Content-Security-Policy and would move event definitions into a web
# console. See src/analytics/google-tag.tsx.
#
# IMPORTANT (Vercel): do NOT tick "Sensitive" on any NEXT_PUBLIC_ variable.
# Vercel withholds Sensitive values at build time, so the inlined value
# silently becomes `undefined` and the tag never loads.

# GA4 Measurement ID. Found in: GA4 Admin → Data Streams → your web stream.
# Format: G-XXXXXXXXXX. Unset ⇒ GoogleTag renders nothing and every helper in
# src/analytics/events.ts skips its GA4 leg.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads conversion ID. Found in: Google Ads → Goals → Conversions →
# your conversion action → Tag setup. Format: AW-XXXXXXXXXX.
# Optional and independent of GA4 — leave blank if you are not running Ads yet.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion LABEL for the Purchase action, from the same Tag setup screen.
# Google shows it as 'AW-XXXXXXXXXX/aBcDeFgHiJ' — put only the part AFTER the
# slash here. Without it the conversion is skipped entirely, because Google
# silently discards an unlabelled conversion, which looks identical to working.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# Enhanced Conversions — set to exactly 'true' to send the customer's email and
# phone to Google with the purchase conversion. Google's tag hashes them in the
# browser before transmission, but this is still a disclosure of personal data
# to a third party.
#
# Deliberately OFF by default. Leave it off until the consent banner ships,
# then gate it on consent.
NEXT_PUBLIC_GOOGLE_ADS_ENHANCED_CONVERSIONS=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Admin routes are protected by middleware (src/middleware.ts).
# The admin user must have app_metadata.role = 'admin' set in Supabase Auth.
# No env var is required for this — role is enforced by the middleware
# reading the Supabase session server-side.
#
# To grant admin access to a user:
#   Supabase Dashboard → Authentication → Users → [user] → Edit → app_metadata:
#   { "role": "admin" }

# -----------------------------------------------------------------------------
# Optional: Next.js
# -----------------------------------------------------------------------------
# Uncomment if you need to configure a custom Next.js base URL for local dev.
# NEXTAUTH_URL=http://localhost:3000
